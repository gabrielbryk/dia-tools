name: CI
on:
  push:
  pull_request:
permissions:
  contents: read
jobs:
  test:
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: 1.3.13
      - run: brew install sqlcipher
      - run: bun install --frozen-lockfile
      - run: bun scripts/build-ui.ts
      - run: bun run check
      - run: bunx playwright install chromium
      - run: bun run test:ui
      - run: bun run build:portable
      - name: Test bundled runtime without Homebrew on PATH
        shell: bash
        run: |
          binary="$(pwd)/dist/dia-tools-darwin-$(uname -m | sed 's/x86_64/x64/')-portable"
          env -u DIA_SQLCIPHER_LIBRARY PATH=/usr/bin:/bin "$binary" self-test
      - uses: actions/upload-artifact@v4
        with:
          name: dia-tools-portable
          path: |
            dist/*.tar.gz
            dist/*.sha256
