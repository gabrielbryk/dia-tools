{
  "name": "dia-tools",
  "version": "0.2.0",
  "description": "Local CLI and agent skills for inspecting and editing Dia's encrypted browser stores on macOS",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dia-tools": "src/cli.ts"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "files": [
    "src",
    "skills",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun scripts/build-ui.ts && bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "build:portable": "bun scripts/build.ts --portable",
    "check": "bun run typecheck && bun test",
    "test:ui": "bun scripts/test-ui.ts && bun scripts/test-profile-ui.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:usage-ui": "bun scripts/test-usage-ui.ts"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "commander": "14.0.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "playwright": "1.64.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
